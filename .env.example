# App Setup
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Serverless Postgres Database (Drizzle ORM)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-placeholder-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clerk Authentication (SaaS Hosted Auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZXhhbXBsZS5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Groq API Key (AI Agent Configuration Generator)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Agent model provider: "gemini" or "openai". Gemini is used automatically when
# GEMINI_API_KEY is set and AGENT_MODEL_PROVIDER is omitted.
AGENT_MODEL_PROVIDER=gemini

# Gemini API Key & Model (AI Agent Execution)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_AGENT_MODEL=gemini-3.8-flash
GEMINI_AGENT_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-latest

# OpenAI API Key & Model (optional alternative for AI Agent Execution)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Composio Tool Integration Keys
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_AOI_KEY=your_composio_api_key_here

# Browserbase Tool Credentials
BROWSERBASE_API_KEY=bb_your_browserbase_api_key_here
BROWSERBASE_AGENT_ID=your_browserbase_agent_id_here
